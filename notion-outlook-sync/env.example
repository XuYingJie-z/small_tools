# Notion internal integration token. Only Read content capability is required.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_VERSION=2026-03-11

# Microsoft Entra public-client application ID. Do not add a client secret.
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# Leave empty to use the default Outlook calendar.
# To use a dedicated calendar, put its Microsoft Graph calendar ID here.
OUTLOOK_CALENDAR_ID=

# Used only when a Notion datetime has no offset/time-zone information.
# 时区，非全天任务可能要测试一下时区的问题，我记得 notion 和outlook 会不太一样，notion 需要迁就 Outlook
DEFAULT_TIMEZONE=Asia/Shanghai

SYNC_CONFIG=config.json
STATE_DB=sync_state.sqlite3
TOKEN_CACHE=msal_token_cache.json
LOG_LEVEL=INFO

# Start with DRY_RUN=true. Change to false after checking the log.
DRY_RUN=true

# Safety switch. When true, an Outlook event is deleted when its mapped Notion
# page disappears from a successfully queried data source. Keep false initially.
DELETE_MISSING_EVENTS=false
